# WorkBuddy 自动签到 —— Nginx 反向代理参考配置
#
# 宝塔面板里更简单的做法：网站 → 添加站点 → 设置 → 反向代理
#   代理名称：workbuddy
#   目标 URL：http://127.0.0.1:8848
#   发送域名：$host
# 然后到「SSL」页申请 Let's Encrypt 证书并开启「强制 HTTPS」。
#
# 如果想要更细的控制，可以直接用下面的 server 段。

server {
    listen 80;
    server_name wb.example.com;          # ← 改成你自己的域名

    # 强制跳转 HTTPS（申请证书后打开）
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name wb.example.com;          # ← 改成你自己的域名

    # 宝塔申请证书后会自动填好这两行，按实际情况调整路径
    ssl_certificate     /www/server/panel/vhost/cert/wb.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/wb.example.com/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # 只允许这个站点的密码登录，不暴露任何静态目录
    root /www/wwwroot/workbuddy-checkin/app/static;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    client_max_body_size 2m;

    location / {
        proxy_pass         http://127.0.0.1:8848;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # 扫码轮询是短请求，但这个值给宽一点更保险
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        proxy_buffering       off;
    }

    # 可选：如果通过域名直连、想让宝塔的证书续期不受影响
    location /.well-known/acme-challenge/ {
        root /www/wwwroot/wb.example.com;
    }
}
