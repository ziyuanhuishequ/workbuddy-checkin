# WorkBuddy 自动签到 —— 环境变量示例
# 复制成 .env 后按需修改；打勾的项建议一定要改。

# 监听地址。默认只监听本机（配合 Nginx 反代最安全）。
# 想直接开放端口就设成 0.0.0.0，但务必先确认下面设了强密码。
WB_HOST=127.0.0.1

# 监听端口
WB_PORT=8848

# ★ 控制台密码。留空会自动生成到 data/password.txt（并在启动日志里打印一次）。
WB_PASSWORD=

# 签名密钥（用于控制台会话签名 + 凭据加密）。留空会自动生成到 data/secret.key。
# 注意：这个值变了，已保存账号的 token 就解不开了，需要重新添加一次账号。
WB_SECRET_KEY=

# 数据目录（数据库、密钥、日志）
WB_DATA_DIR=./data

# 时区偏移，默认东八区
WB_TZ_OFFSET=8

# 单个上游请求超时（秒）
WB_HTTP_TIMEOUT=30

# 登录链接有效期（秒）。每次点「打开电脑端登录页」都会重新申请一条
WB_QR_TTL=300

# 是否允许「上传令牌文件 / 粘贴令牌」导入账号（0 关闭，只保留电脑端登录）
WB_ALLOW_MANUAL_IMPORT=1

# 上游接口域名（v1.1.0 起官方主站是 www.workbuddy.cn）。
# 一般不用改；网页「设置 → 网络」里也能改，改完立即生效、不用重启。
WB_API_BASE=https://www.workbuddy.cn

# 后台调度心跳间隔（秒），一般不用改
WB_TICK=30

# 站长联系入口（可选）。填了之后，账号失效 / 签到失败的通知里会引导用户来这里找人；
# 留空则只说「联系站点管理员」，不会出现任何外部地址。
WB_SITE_OWNER=
